<?xml version="1.0" encoding="utf-8"?>
<!--
  섬 페이지 2: 안내 순간 / 도착 확장(Expanded). 1062dp 폭 (Figma 내비 영역 1682dp 폭 기준).
  안내 순간과 도착은 문구만 다르며, GuideIslandPage 가 채운다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Dahta.IslandShadow"
    android:layout_width="1062dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_expanded"
    android:orientation="vertical"
    android:paddingStart="58dp"
    android:paddingTop="58dp"
    android:paddingEnd="58dp"
    android:paddingBottom="52dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="89dp"
            android:layout_height="89dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_lane_glass_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/island_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:includeFontPadding="false"
                android:textColor="@color/island_on_background"
                android:textSize="45sp" />

            <TextView
                android:id="@+id/island_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:textColor="@color/island_on_background_secondary"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="79dp"
        android:layout_marginTop="21dp"
        android:background="@drawable/bg_island_caption"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="29dp"
        android:paddingEnd="29dp">

        <ImageView
            android:layout_width="29dp"
            android:layout_height="29dp"
            android:importantForAccessibility="no"
            android:src="@drawable/figma_speaker" />

        <TextView
            android:id="@+id/island_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/island_on_background"
            android:textSize="24sp" />
    </LinearLayout>
</LinearLayout>
