<?xml version="1.0" encoding="utf-8"?>
<!--
  섬 페이지 3: 호출 도착. 691dp 폭 (Figma 내비 영역 1682dp 폭 기준).
  새 호출이 들어왔어요 + [모시러 가기] [나중에]. 버튼 동작은 CallIslandPage 가 연결한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="691dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_call"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="99dp"
            android:layout_height="99dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_logo_lane_glass_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:includeFontPadding="false"
                android:text="@string/island_call_title"
                android:textColor="@color/text_dark_primary"
                android:textSize="29sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/medium"
                android:includeFontPadding="false"
                android:text="@string/island_call_desc"
                android:textColor="@color/text_dark_tertiary"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="79dp"
        android:layout_marginTop="39dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/island_call_accept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_island_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/island_call_accept"
            android:textColor="@color/text_light_primary"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/island_call_later"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_island_button_secondary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/semi_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/island_call_later"
            android:textColor="@color/text_dark_primary"
            android:textSize="26sp" />
    </LinearLayout>
</LinearLayout>
