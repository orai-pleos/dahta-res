<?xml version="1.0" encoding="utf-8"?>
<!--
  섬 페이지: 손님 마중(호출을 잡고 탑승 지점으로 가는 중). 흰 알약 + 파란 원 + 번지는 고리 + 거리.
  방향 아이콘 / 거리 / 고리 세기는 PickupIslandPage 가 채운다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Dahta.IslandShadow"
    android:layout_width="wrap_content"
    android:layout_height="132dp"
    android:background="@drawable/bg_pill_white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="45dp">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:clipChildren="false">

        <com.orai.dahta.ui.PulseRingsView
            android:id="@+id/island_pickup_rings"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/island_pickup_icon"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_arrow" />
    </FrameLayout>

    <TextView
        android:id="@+id/island_pickup_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/bold"
        android:includeFontPadding="false"
        android:textColor="@color/text_dark_primary"
        android:textSize="52sp" />
</LinearLayout>
