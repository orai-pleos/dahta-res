<?xml version="1.0" encoding="utf-8"?>
<!-- 스위치 ON: 초록 트랙 80x48 / 모서리 16, 토글 32x32 / 모서리 8 (오른쪽) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="80dp"
        android:height="48dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/informative_active" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:end="8dp"
        android:gravity="end|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/icon_light_primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
