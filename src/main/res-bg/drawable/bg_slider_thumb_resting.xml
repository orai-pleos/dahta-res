<?xml version="1.0" encoding="utf-8"?>
<!-- 슬라이더 thumb: 평소. 48 x 48dp 원 + 아래로 옅은 그림자 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 그림자(바깥, 옅게) -->
    <item
        android:bottom="-10dp"
        android:left="-4dp"
        android:right="-4dp"
        android:top="10dp">
        <shape android:shape="oval">
            <solid android:color="#14131417" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <!-- 그림자(안쪽, 진하게) -->
    <item
        android:bottom="-5dp"
        android:left="-1dp"
        android:right="-1dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#26131417" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
    <!-- thumb 본체 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/text_dark_primary" />
            <size
                android:width="48dp"
                android:height="48dp" />
        </shape>
    </item>
</layer-list>
