<?xml version="1.0" encoding="utf-8"?>
<com.orai.dahta.DesignCanvasLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_canvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gradient_start">
    <FrameLayout
        android:layout_width="1700dp"
        android:layout_height="1184dp"
        android:background="@drawable/figma_main_background"
        android:clipChildren="false"
        android:clipToPadding="false">
        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"
            android:paddingTop="48dp"
            android:paddingBottom="64dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/figma_main_logo"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="yes"
                    android:contentDescription="@string/cd_logo"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bold"
                    android:text="@string/app_name"
                    android:textSize="56sp"
                    android:textColor="@color/text_dark_primary"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_weight="1"
                android:layout_marginTop="40dp"
                android:padding="65.5dp"
                android:background="@drawable/bg_card_glass"
                android:baselineAligned="false">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="55dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/chip_taxi_care"
                            android:textSize="28sp"
                            android:textColor="@color/informative_positive"
                            android:gravity="center"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:background="@drawable/bg_chip"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="113dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/headline_line1"
                            android:textSize="96sp"
                            android:textColor="@color/text_dark_primary"
                            android:layout_marginTop="28dp"
                            android:gravity="center_vertical"
                            android:singleLine="true"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="113dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/headline_line2"
                            android:textSize="96sp"
                            android:textColor="@color/informative_positive"
                            android:layout_marginTop="28dp"
                            android:gravity="center_vertical"
                            android:singleLine="true"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/headline_sub"
                            android:textSize="36sp"
                            android:textColor="@color/text_dark_secondary"
                            android:layout_marginTop="28dp"
                            android:gravity="center_vertical"/>
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="126dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="36dp"
                            android:paddingEnd="28dp"
                            android:background="@drawable/bg_card_white_md">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_weight="1">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="45dp"
                                    android:includeFontPadding="false"
                                    android:fontFamily="@font/bold"
                                    android:text="@string/care_mode_title"
                                    android:textSize="36sp"
                                    android:textColor="@color/text_dark_primary"
                                    android:gravity="center_vertical"/>
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="35dp"
                                    android:includeFontPadding="false"
                                    android:fontFamily="@font/medium"
                                    android:text="@string/care_mode_desc"
                                    android:textSize="28sp"
                                    android:textColor="@color/text_dark_tertiary"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center_vertical"/>
                            </LinearLayout>
                            <androidx.appcompat.widget.AppCompatCheckBox
                                android:id="@+id/switch_care_mode"
                                android:layout_width="80dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="20dp"
                                android:button="@null"
                                android:background="@drawable/ivi_switch"
                                android:contentDescription="@string/care_mode_title"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="24dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="150dp"
                                android:orientation="horizontal"
                                style="@style/Widget.Dahta.RaisedButton"
                        android:id="@+id/btn_start"
                                android:gravity="center"
                                android:background="@drawable/bg_button_primary"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                android:contentDescription="@string/start_drive">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:includeFontPadding="false"
                                    android:fontFamily="@font/bold"
                                    android:text="@string/start_drive"
                                    android:textSize="48sp"
                                    android:textColor="@color/text_light_primary"/>
                                <ImageView
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:src="@drawable/figma_arrow"
                                    android:scaleType="fitXY"
                                    android:importantForAccessibility="no"
                                    android:layout_marginStart="16dp"/>
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="35dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/start_caption"
                            android:textSize="28sp"
                            android:textColor="@color/text_dark_tertiary"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:singleLine="true"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="560dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginStart="64dp"
                    android:padding="45.5dp"
                    android:background="@drawable/bg_card_white">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="45dp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/bold"
                        android:text="@string/flow_title"
                        android:textSize="36sp"
                        android:textColor="@color/text_dark_primary"
                        android:gravity="center_vertical"/>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_circle_blue">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/figma_car"
                                android:scaleType="fitXY"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/flow_door_title"
                                android:textSize="34sp"
                                android:textColor="@color/text_dark_primary"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/medium"
                                android:text="@string/flow_door_desc"
                                android:textSize="28sp"
                                android:textColor="@color/text_dark_tertiary"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_circle_tint">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/figma_speaker"
                                android:scaleType="fitXY"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/flow_greet_title"
                                android:textSize="34sp"
                                android:textColor="@color/text_dark_primary"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/medium"
                                android:text="@string/flow_greet_desc"
                                android:textSize="28sp"
                                android:textColor="@color/text_dark_tertiary"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_circle_tint">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/figma_mic"
                                android:scaleType="fitXY"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/flow_listen_title"
                                android:textSize="34sp"
                                android:textColor="@color/text_dark_primary"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/medium"
                                android:text="@string/flow_listen_desc"
                                android:textSize="28sp"
                                android:textColor="@color/text_dark_tertiary"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                    <Space
                        android:layout_width="1dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <FrameLayout
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_circle_tint">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/figma_pin"
                                android:scaleType="fitXY"
                                android:importantForAccessibility="no"
                                android:layout_gravity="center"/>
                        </FrameLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_marginStart="24dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="43dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/flow_arrive_title"
                                android:textSize="34sp"
                                android:textColor="@color/text_dark_primary"
                                android:gravity="center_vertical"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="35dp"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/medium"
                                android:text="@string/flow_arrive_desc"
                                android:textSize="28sp"
                                android:textColor="@color/text_dark_tertiary"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/summary_overlay"
            android:background="#73131417"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">
            <LinearLayout
                android:layout_width="960dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:paddingStart="72dp"
                android:paddingEnd="72dp"
                android:paddingTop="72dp"
                android:paddingBottom="64dp"
                android:background="@drawable/bg_summary_modal"
                android:elevation="20dp"
                android:clickable="true">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:src="@drawable/figma_main_logo"
                        android:scaleType="fitXY"
                        android:importantForAccessibility="no"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_marginStart="28dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="76dp"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/summary_title"
                            android:textSize="64sp"
                            android:textColor="@color/text_dark_primary"
                            android:gravity="center_vertical"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/summary_subtitle"
                            android:textSize="34sp"
                            android:textColor="@color/text_dark_secondary"
                            android:layout_marginTop="8dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:paddingTop="40dp"
                    android:paddingBottom="40dp"
                    android:background="@drawable/bg_summary_primary"
                    android:layout_marginTop="40dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/summary_guests"
                            android:textSize="32sp"
                            android:textColor="@color/text_dark_secondary"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/stat_unavailable"
                                android:textSize="140sp"
                                android:textColor="@color/informative_positive"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/bold"
                                android:text="@string/unit_people"
                                android:textSize="56sp"
                                android:textColor="@color/text_dark_primary"
                                android:layout_marginStart="10dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/summary_duration"
                            android:textSize="32sp"
                            android:textColor="@color/text_dark_secondary"
                            android:gravity="end"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/duration_zero"
                            android:textSize="56sp"
                            android:textColor="@color/text_dark_primary"
                            android:id="@+id/summary_duration"
                            android:gravity="end"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="40dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_weight="1"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp"
                        android:background="@drawable/bg_summary_secondary">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/summary_foreign"
                            android:textSize="32sp"
                            android:textColor="@color/text_dark_secondary"
                            android:layout_weight="1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/stat_unavailable"
                            android:textSize="48sp"
                            android:textColor="@color/informative_positive"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_weight="1"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="28dp"
                        android:background="@drawable/bg_summary_secondary"
                        android:layout_marginStart="24dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/medium"
                            android:text="@string/care_mode_title"
                            android:textSize="32sp"
                            android:textColor="@color/text_dark_secondary"
                            android:layout_weight="1"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/bold"
                            android:text="@string/stat_unavailable"
                            android:textSize="48sp"
                            android:textColor="@color/informative_active"/>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/medium"
                    android:text="@string/summary_privacy"
                    android:textSize="28sp"
                    android:textColor="@color/text_dark_tertiary"
                    android:layout_marginTop="40dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/bold"
                    android:text="@string/confirm"
                    android:textSize="48sp"
                    android:textColor="@color/text_light_primary"
                    android:id="@+id/btn_summary_confirm"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:background="@drawable/bg_button_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"/>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</com.orai.dahta.DesignCanvasLayout>
