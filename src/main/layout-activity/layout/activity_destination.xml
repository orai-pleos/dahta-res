<?xml version="1.0" encoding="utf-8"?>

<com.orai.dahta.DesignCanvasLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_canvas"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gradient_start">

    <FrameLayout
        android:layout_width="1700dp"
        android:layout_height="1184dp"
        android:background="@drawable/figma_main_background"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="43dp"
            android:paddingTop="41dp"
            android:paddingEnd="43dp"
            android:paddingBottom="42dp">

            <!-- 헤더: 로고 + 닿다 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:contentDescription="@string/cd_logo"
                    android:scaleType="fitXY"
                    android:src="@drawable/figma_main_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:fontFamily="@font/bold"
                    android:includeFontPadding="false"
                    android:text="@string/app_name"
                    android:textColor="@color/text_dark_primary"
                    android:textSize="42sp" />
            </LinearLayout>

            <!-- 유리 카드 (그림자: X 0 / Y 16 / 흐림 56 / #2954C7 8%) -->
            <FrameLayout
                style="@style/Widget.Dahta.RaisedCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_glass">

                <!-- 상태 1: 듣는 중 -->
                <LinearLayout
                    android:id="@+id/destination_listening"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingBottom="138dp">

                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_circle_tint">

                        <FrameLayout
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_wait_ring_inner">

                            <FrameLayout
                                android:layout_width="128dp"
                                android:layout_height="128dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_blue">

                                <ImageView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/figma_mic"
                                    android:tint="@android:color/white" />
                            </FrameLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:fontFamily="@font/semi_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="14dp"
                        android:text="@string/destination_listening_prompt"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="38sp" />
                </LinearLayout>

                <!-- 상태 2: 검색 결과 -->
                <LinearLayout
                    android:id="@+id/destination_results"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="59dp"
                    android:paddingTop="52dp"
                    android:paddingEnd="59dp"
                    android:visibility="gone">

                    <!-- 왼쪽: 제목 + 결과 목록 -->
                    <LinearLayout
                        android:layout_width="818dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_title"
                                    android:textColor="@color/text_dark_primary"
                                    android:textSize="40sp" />

                                <TextView
                                    android:id="@+id/destination_summary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_summary"
                                    android:textColor="@color/text_dark_tertiary"
                                    android:textSize="26sp" />
                            </LinearLayout>

                            <LinearLayout
                                style="@style/Widget.Dahta.RaisedCard"
                                android:id="@+id/btn_listen_again"
                                android:layout_width="wrap_content"
                                android:layout_height="70dp"
                                android:background="@drawable/bg_chip"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="26dp"
                                android:paddingEnd="30dp">

                                <ImageView
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/figma_mic"
                                    app:tint="@color/informative_positive" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:fontFamily="@font/bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_listen_again"
                                    android:textColor="@color/informative_positive"
                                    android:textSize="28sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 1번(선택됨) -->
                        <LinearLayout
                            style="@style/Widget.Dahta.RaisedCard"
                            android:id="@+id/destination_result_1"
                            android:layout_width="match_parent"
                            android:layout_height="157dp"
                            android:layout_marginTop="28dp"
                            android:background="@drawable/bg_result_item_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_1_name"
                                    android:textColor="@color/informative_positive"
                                    android:textSize="37sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_1_type"
                                    android:textColor="@color/text_dark_tertiary"
                                    android:textSize="25sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/semi_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_1_distance"
                                    android:textColor="@color/text_dark_primary"
                                    android:textSize="32sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_1_address"
                                    android:textColor="@color/text_dark_secondary"
                                    android:textSize="27sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 2번 -->
                        <LinearLayout
                            style="@style/Widget.Dahta.RaisedCard"
                            android:id="@+id/destination_result_2"
                            android:layout_width="match_parent"
                            android:layout_height="153dp"
                            android:layout_marginTop="25dp"
                            android:background="@drawable/bg_result_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_2_name"
                                    android:textColor="@color/informative_positive"
                                    android:textSize="37sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_2_type"
                                    android:textColor="@color/text_dark_tertiary"
                                    android:textSize="25sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/semi_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_2_distance"
                                    android:textColor="@color/text_dark_primary"
                                    android:textSize="32sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_2_address"
                                    android:textColor="@color/text_dark_secondary"
                                    android:textSize="27sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- 3번 -->
                        <LinearLayout
                            style="@style/Widget.Dahta.RaisedCard"
                            android:id="@+id/destination_result_3"
                            android:layout_width="match_parent"
                            android:layout_height="153dp"
                            android:layout_marginTop="25dp"
                            android:background="@drawable/bg_result_item"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_3_name"
                                    android:textColor="@color/informative_positive"
                                    android:textSize="37sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_3_type"
                                    android:textColor="@color/text_dark_tertiary"
                                    android:textSize="25sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/semi_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_3_distance"
                                    android:textColor="@color/text_dark_primary"
                                    android:textSize="32sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:fontFamily="@font/medium"
                                    android:includeFontPadding="false"
                                    android:text="@string/destination_result_3_address"
                                    android:textColor="@color/text_dark_secondary"
                                    android:textSize="27sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 오른쪽: 손님이 이렇게 말했어요 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="50dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="51dp"
                                android:layout_height="51dp"
                                android:background="@drawable/bg_circle_tint">

                                <ImageView
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/figma_mic"
                                    app:tint="@color/informative_positive" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:fontFamily="@font/medium"
                                android:includeFontPadding="false"
                                android:text="@string/destination_heard_label"
                                android:textColor="@color/text_dark_secondary"
                                android:textSize="29sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/destination_heard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="26dp"
                            android:fontFamily="@font/bold"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="22dp"
                            android:text="@string/destination_heard_text"
                            android:textColor="@color/text_dark_primary"
                            android:textSize="84sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</com.orai.dahta.DesignCanvasLayout>
