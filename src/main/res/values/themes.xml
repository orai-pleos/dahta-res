<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Dahta" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color : 닿다 파랑 (DS informative/positive) -->
        <item name="colorPrimary">@color/informative_positive</item>
        <item name="colorPrimaryVariant">@color/brand_indigo</item>
        <item name="colorOnPrimary">@color/text_light_primary</item>

        <!-- Secondary brand color : 듣는 중 초록 (DS informative/active) -->
        <item name="colorSecondary">@color/informative_active</item>
        <item name="colorSecondaryVariant">@color/informative_active</item>
        <item name="colorOnSecondary">@color/on_informative_active</item>

        <!-- Surface / Background / Error -->
        <item name="colorSurface">@color/surface_basic</item>
        <item name="colorOnSurface">@color/text_dark_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="colorOnBackground">@color/text_dark_primary</item>
        <item name="colorError">@color/regulation_red</item>
        <item name="colorOnError">@color/text_light_primary</item>

        <!-- 기본 글자색 -->
        <item name="android:textColorPrimary">@color/text_dark_primary</item>
        <item name="android:textColorSecondary">@color/text_dark_tertiary</item>

        <!-- Status bar : 차량에선 시스템이 그리지만, 에뮬레이터·폰에서도 자연스럽게 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
