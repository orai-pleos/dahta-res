<resources>
    <!--
      눌러서 쓰는 버튼에 입히는 바깥 그림자. Figma: Y 16 / 흐림 48 / 색 #131417.
      그림자는 elevation 으로 그리므로 버튼 배경이 둥근 모양(outline)을 가져야 하고,
      부모가 그림자를 잘라내지 않도록 Motion.allowShadowOverflow() 를 같이 호출한다.
      세기는 shadow_spot / shadow_ambient 의 알파 값으로 조절한다.
    -->
    <style name="Widget.Dahta.RaisedButton" parent="">
        <item name="android:elevation">16dp</item>
        <item name="android:outlineSpotShadowColor">@color/shadow_spot</item>
        <item name="android:outlineAmbientShadowColor">@color/shadow_ambient</item>
    </style>

    <!-- 대기 화면의 흰 카드(손님을 기다리고 있어요, 진행 단계). Figma: X 0 / Y 16 / 흐림 56 / #2954C7 8%. -->
    <style name="Widget.Dahta.RaisedCard" parent="">
        <item name="android:elevation">18dp</item>
        <item name="android:outlineSpotShadowColor">@color/shadow_card_spot</item>
        <item name="android:outlineAmbientShadowColor">@color/shadow_card_ambient</item>
    </style>

    <!--
      다이나믹 아일랜드. Figma: X 0 / Y 20 / 흐림 60 / #000000 28%.
      섬은 별도 오버레이 창 안에 그려지므로, 그림자가 잘리지 않도록 view_island 틀에
      island_shadow_padding_* 만큼 여백을 준다.
    -->
    <style name="Widget.Dahta.IslandShadow" parent="">
        <item name="android:elevation">24dp</item>
        <item name="android:outlineSpotShadowColor">@color/shadow_island_spot</item>
        <item name="android:outlineAmbientShadowColor">@color/shadow_island_ambient</item>
    </style>
</resources>
