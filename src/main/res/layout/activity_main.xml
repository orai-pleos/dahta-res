<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_landscape_17"
    android:baselineAligned="false"
    android:orientation="vertical">

    <!-- ========== 헤더: 로고 + 서비스명 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="64dp"
        android:layout_marginTop="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_logo_lane" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/bold"
            android:text="@string/app_name"
            android:textColor="@color/text_dark_primary"
            android:textSize="54sp" />
    </LinearLayout>

    <!-- ========== 메인 카드 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="64dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="64dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_glass"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="64dp">

        <!-- 좌측: 헤드라인 / 배려 모드 / 시작 버튼 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="817"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:background="@drawable/bg_chip"
                android:fontFamily="@font/semi_bold"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/chip_taxi_care"
                android:textColor="@color/informative_positive"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:fontFamily="@font/bold"
                android:text="@string/headline_line1"
                android:textColor="@color/text_dark_primary"
                android:textSize="92sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/bold"
                android:text="@string/headline_line2"
                android:textColor="@color/informative_positive"
                android:textSize="92sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/medium"
                android:text="@string/headline_sub"
                android:textColor="@color/text_dark_primary"
                android:textSize="34sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 배려 모드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:background="@drawable/bg_card_white_md"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="36dp"
                android:paddingEnd="28dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="@string/care_mode_title"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="33sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/care_mode_desc"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="27sp" />
                </LinearLayout>

                <!-- Pleos IVI 스위치 이미지(on/off)를 배경으로 쓰는 체크 버튼, 80 x 48dp -->
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/switch_care_mode"
                    android:layout_width="80dp"
                    android:layout_height="48dp"
                    android:background="@drawable/ivi_switch"
                    android:button="@null"
                    android:checked="true"
                    android:contentDescription="@string/care_mode_title" />
            </LinearLayout>

            <!-- 운행 시작 버튼 -->
            <LinearLayout
                android:id="@+id/btn_start"
                android:layout_width="match_parent"
                android:layout_height="149dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/semi_bold"
                    android:text="@string/start_drive"
                    android:textColor="@color/text_light_primary"
                    android:textSize="45sp" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/medium"
                android:gravity="center"
                android:text="@string/start_caption"
                android:textColor="@color/text_dark_tertiary"
                android:textSize="27sp" />
        </LinearLayout>

        <!-- 우측: 자동 안내 흐름 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="64dp"
            android:layout_weight="561"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:paddingStart="45dp"
            android:paddingTop="44dp"
            android:paddingEnd="45dp"
            android:paddingBottom="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bold"
                android:text="@string/flow_title"
                android:textColor="@color/text_dark_primary"
                android:textSize="34sp" />

            <!-- 1. 문이 열리면 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="47dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="match_parent">

                    <!-- 타임라인 선: 첫 단계는 아래쪽 절반만 -->
                    <LinearLayout
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@color/surface_accent" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_circle_blue">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flow_car"
                            app:tint="@color/text_light_primary" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="@string/flow_door_title"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="33sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/flow_door_desc"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 인사하고 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="match_parent">

                    <!-- 타임라인 선: 위아래 전체 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:background="@color/surface_accent" />

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flow_speaker"
                            app:tint="@color/informative_positive" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="@string/flow_greet_title"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="33sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/flow_greet_desc"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 목적지를 듣고 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="match_parent">

                    <!-- 타임라인 선: 위아래 전체 -->
                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:background="@color/surface_accent" />

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flow_mic"
                            app:tint="@color/informative_positive" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="@string/flow_listen_title"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="33sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/flow_listen_desc"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 도착하면 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="match_parent">

                    <!-- 타임라인 선: 마지막 단계는 위쪽 절반만 -->
                    <LinearLayout
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@color/surface_accent" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_flow_pin"
                            app:tint="@color/informative_positive" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bold"
                        android:text="@string/flow_arrive_title"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="33sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/medium"
                        android:text="@string/flow_arrive_desc"
                        android:textColor="@color/text_dark_tertiary"
                        android:textSize="26sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
